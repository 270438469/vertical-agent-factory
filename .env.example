# Customer-facing API key. Generate a long random value per tenant.
VAF_API_KEY_DEMO=replace-with-at-least-32-random-bytes

# Configure only the model vendors that a tenant may use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# China model provider credentials. Configure only providers enabled for a tenant.
DASHSCOPE_API_KEY=
# Example for a new Beijing workspace:
# DASHSCOPE_BASE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
ARK_API_KEY=
ARK_BASE_URL=
HUNYUAN_API_KEY=
QIANFAN_API_KEY=
STEPFUN_API_KEY=
YI_API_KEY=
BAICHUAN_API_KEY=
SPARK_API_KEY=
SILICONFLOW_API_KEY=
SENSENOVA_API_KEY=
MIMO_API_KEY=
LONGCAT_API_KEY=

VAF_COMMERCIAL_CONFIG=config/commercial.yaml
VAF_API_HOST=127.0.0.1
VAF_API_PORT=8000
VAF_MAX_REQUEST_BYTES=262144

# No-code setup UI. Set a temporary random value of at least 32 characters only
# while configuring. The setup API is local-only unless explicitly overridden.
VAF_SETUP_ADMIN_KEY=
VAF_SETUP_ALLOW_REMOTE=0
# Comma-separated browser origins allowed to call the local setup service.
VAF_SETUP_ALLOWED_ORIGINS=
VAF_SETUP_ENV_FILE=.env
